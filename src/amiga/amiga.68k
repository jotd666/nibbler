AttnFlags = 0x128
AFB_68010 = 0
AFB_68020 = 1

NO68020 = 1



TILE_PLANE_X_SHIFT = 0


FG_TILE_NB_CLUTS_POW = 3
FG_TILE_NB_CLUTS = 1<<FG_TILE_NB_CLUTS_POW
FG_TILE_COUNT = 0x100

BG_TILE_NB_CLUTS_POW = 3
BG_TILE_NB_CLUTS = 1<<BG_TILE_NB_CLUTS_POW
BG_TILE_COUNT = 0x200  | and only 0 and 0x100-0x1FF are used


FG_SCREEN_TILE_ADDRESS = 0x400
BG_SCREEN_TILE_ADDRESS = 0x800
FG_SCREEN_COLOR_ADDRESS = 0xC00
BG_SCREEN_COLOR_ADDRESS = FG_SCREEN_COLOR_ADDRESS

FG_TILE_LOG_LENGTH = FG_TILE_NB_CLUTS*FG_TILE_COUNT
BG_TILE_LOG_LENGTH = BG_TILE_NB_CLUTS*BG_TILE_COUNT


	
* start displaying earlier in ntsc mode, allowing
* full display
NTSC_Y_SHIFT = 12

Y_MAX = 256

SCORE_FILE_SIZE = 0x23   | wrong

LOG_BUFFER_SIZE = 0x2000

BASE_BPLCON2_VALUE = 0x0064		| sprites above all playfields



	

OPT_ENABLE_DOUBLE_BUFFERING = 1

_custom = 0xDFF000

OPT_ENABLE_MULTIPLEXED_SPRITES = 0

NB_FG_PLANES = 3
NB_BG_PLANES = NB_FG_PLANES
TOTAL_NB_COLORS = 1<<NB_FG_PLANES
NB_BYTES_PER_ROW = 40


NB_LINES = 256
NB_PLAYFIELD_LINES = NB_LINES


SCREEN_PLANE_SIZE = NB_BYTES_PER_ROW*NB_PLAYFIELD_LINES

SCREEN_SIZE = SCREEN_PLANE_SIZE*NB_FG_PLANES
BG_SCREEN_SIZE = SCREEN_SIZE
FG_SCREEN_SIZE = SCREEN_SIZE

BG_SCREEN_PLANE_SIZE = SCREEN_PLANE_SIZE
FG_SCREEN_PLANE_SIZE = SCREEN_PLANE_SIZE
BG_NB_BYTES_PER_ROW = NB_BYTES_PER_ROW
FG_NB_BYTES_PER_ROW = NB_BYTES_PER_ROW

BIT_START_1P = 7
BIT_START_2P = 6

BIT_LEFT = 7
BIT_RIGHT = 6
BIT_UP = 5
BIT_DOWN = 4



	
	.macro	WAIT_BLIT
	.ifndef	RELEASE
	cmp.l	#_custom,a5
	jeq		0f
	BREAKPOINT	"custom should be set in A5"
0:
	.endif
	move.w	#0x8400,(dmacon,a5)		| blitter high priority
wait\@:
	BTST	#6,(dmaconr,a5)
	BNE.S	wait\@
	move.w	#0x0400,(dmacon,a5)		| blitter normal priority
.endm

	.macro MUL_TABLE value,len
mul\value\()_table:
	.set    mulv,0
	.rept	\len
	dc.w	mulv
	.set	mulv,mulv+\value
	.endr
.endm


* debug macro that colors the screen until LMB pressed
.macro 	blitz_bypass
	move.w	d0,-(a7)
	clr.w	d0
loop\@:
	move.w	d0,_custom+color
	btst	#6,0xbfe001
	beq.b	out\@
	addq.w	#1,d0
	bra.b	loop\@
out\@:
	move.w	(a7)+,d0
	nop
.endm

* same thing but if LMB is pressed when entering, macro waits for release)
.macro blitz
w\@:
	btst	#6,0xbfe001
	beq.b	w\@
	blitz_bypass
.endm

	

* exports

	.global		_resload
	.global		_dosbase
	.global		cheat_used
* osd layer		
	.global osd_break		| for debug	
	.global osd_blitz		| for debug
	.global	osd_sound_command
	.global osd_enable_interrupts
	.global osd_disable_interrupts
	.global	osd_video_byte_dirty
	.global	osd_get_last_known_pc
	.global	osd_write_2103
	.global	osd_write_sound_2100
	.global	osd_write_sound_2101
	.global	osd_set_irq_return_address
	.global	osd_small_wait
	.global	osd_set_title_color
	.global	osd_write_sound_2102
