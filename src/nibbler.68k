	move.b	#0x40,d0                        	| [$5000: lda #$40]
	OP_W_ON_ZP_ADDRESS	move,highscore_player_identifier_be,d0 |  [$5002: sta highscore_player_identifier_be] assumes player 1 beat a highscore
	SET_XC_FLAGS                           	| [$5004: sec]
	OP_R_ON_ZP_ADDRESS	move,p1_score_hundred_ten_b2,d0 |  [$5005: lda p1_score_hundred_ten_b2]
