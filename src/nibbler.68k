	bne	l_30cb                             	| [$30c3: bne $30cb]
	OP_W_ON_ZP_ADDRESS	addq,0xf1,#1 |  [$30c5: inc $f1]
	bne	l_30cb                             	| [$30c7: bne $30cb]
