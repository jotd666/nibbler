	OP_W_ON_ZP_ADDRESS	move,0x3c,d0 |  [$3c16: sta $3c]
	move.b	#0x10,d0                        	| [$3c18: lda #$10]
	jbsr	save_debug_values_7f4d            	| [$3c1a: jsr save_debug_values_7f4d]
	move.b	#0x03,d0                        	| [$3c1d: lda #$03]
	jbsr	osd_sound_start |  [$3c1f: sta sound_2101]
	move.b	#0x0b,d0                        	| [$3c22: lda #$0b]
	jbsr	osd_sound_start |  [$3c24: sta sound_2101]
	move.b	#0x04,d0                        	| [$3c27: lda #$04]
	PUSH_SR
	OP_W_ON_ZP_ADDRESS	move,0x4f,d0 |  [$3c29: sta $4f]
	POP_SR

* now the fun begins. Nibbler is not a sprite but it has continuous movement even
* if it is made of 8x8 tiles. For this, some games use a huge number of static tiles
* but this wouldn't have been possible here as there are 8 possible frames of several tiles
* (head, straight tail, wriggling tail left/right and diamond animated body)
* so the game uses modifiable character RAM in $1000 and copies from character data from ROM.
*
* one memory optimization can be done because bits represent columns, so a tile or its mirrored
* counterpart can be created using straight copy or copy in a different direction (using eor #7 does this)
*
* so we "only" need 3 sets of characters in ROM, up, down and left/right

	OP_R_ON_ZP_ADDRESS	move,snake_head_direction_53,d0 |  [$3c2b: lda snake_head_direction_53]
	cmp.b	#0x01,d0                         	| [$3c2d: cmp #$01]
	beq	dir_down_3c50                      	| [$3c2f: beq dir_down_3c50]
	cmp.b	#0x02,d0                         	| [$3c31: cmp #$02]
	beq	dir_up_3c63                        	| [$3c33: beq dir_up_3c63]
* load $1188 in 1B pointer (char 0x31 onwards)
	move.b	#0x88,d0                        	| [$3c35: lda #$88]
	OP_W_ON_ZP_ADDRESS	move,0x1b,d0 |  [$3c37: sta $1b]
	move.b	#0x11,d0                        	| [$3c39: lda #$11]
	OP_W_ON_ZP_ADDRESS	move,0x1c,d0 |  [$3c3b: sta $1c]
* $60C0 contains a table with 8 16-bit pointers to charset data (first plane) for left/right
	move.b	#0xc0,d0                        	| [$3c3d: lda #$c0]
	OP_W_ON_ZP_ADDRESS	move,charset_data_pointer_17,d0 |  [$3c3f: sta charset_data_pointer_17]
	move.b	#0x60,d0                        	| [$3c41: lda #$60]
	OP_W_ON_ZP_ADDRESS	move,0x18,d0 |  [$3c43: sta $18]
* $6310 contains a table with 8 16-bit pointers to charset data (second plane) for left/right
	move.b	#0x10,d0                        	| [$3c45: lda #$10]
	OP_W_ON_ZP_ADDRESS	move,0x19,d0 |  [$3c47: sta $19]
	move.b	#0x63,d0                        	| [$3c49: lda #$63]
	OP_W_ON_ZP_ADDRESS	move,0x1a,d0 |  [$3c4b: sta $1a]
	jra	l_3c7b                             	| [$3c4d: jmp l_3c7b]

dir_down_3c50:
* $6a00 contains a table with 8 16-bit pointers to charset data (first plane) for down
	clr.b	d0                               	| [$3c50: lda #$00]
	OP_W_ON_ZP_ADDRESS	move,charset_data_pointer_17,d0 |  [$3c52: sta charset_data_pointer_17]
	move.b	#0x6a,d0                        	| [$3c54: lda #$6a]
	OP_W_ON_ZP_ADDRESS	move,0x18,d0 |  [$3c56: sta $18]
* $6c50 contains a table with 8 16-bit pointers to charset data (second plane) for down
	move.b	#0x50,d0                        	| [$3c58: lda #$50]
	OP_W_ON_ZP_ADDRESS	move,0x19,d0 |  [$3c5a: sta $19]
	move.b	#0x6c,d0                        	| [$3c5c: lda #$6c]
	OP_W_ON_ZP_ADDRESS	move,0x1a,d0 |  [$3c5e: sta $1a]
	jra	l_3c73                             	| [$3c60: jmp l_3c73]

dir_up_3c63:
* $6560 contains a table with 8 16-bit pointers to charset data (first plane) for up
	move.b	#0x60,d0                        	| [$3c63: lda #$60]
	OP_W_ON_ZP_ADDRESS	move,charset_data_pointer_17,d0 |  [$3c65: sta charset_data_pointer_17]
	move.b	#0x65,d0                        	| [$3c67: lda #$65]
	OP_W_ON_ZP_ADDRESS	move,0x18,d0 |  [$3c69: sta $18]
* $67B0 contains a table with 8 16-bit pointers to charset data (second plane) for up
	move.b	#0xb0,d0                        	| [$3c6b: lda #$b0]
	OP_W_ON_ZP_ADDRESS	move,0x19,d0 |  [$3c6d: sta $19]
	move.b	#0x67,d0                        	| [$3c6f: lda #$67]
	OP_W_ON_ZP_ADDRESS	move,0x1a,d0 |  [$3c71: sta $1a]
l_3c73:
* $1308: char 0x61 (nibbler body)
	move.b	#0x08,d0                        	| [$3c73: lda #$08]
	OP_W_ON_ZP_ADDRESS	move,0x1b,d0 |  [$3c75: sta $1b]
	move.b	#0x13,d0                        	| [$3c77: lda #$13]
	OP_W_ON_ZP_ADDRESS	move,0x1c,d0 |  [$3c79: sta $1c]
l_3c7b:
	clr.b	d0                               	| [$3c7b: lda #$00]
	OP_W_ON_ZP_ADDRESS	move,0xec,d0 |  [$3c7d: sta $ec]
	OP_R_ON_ZP_ADDRESS	move,frame_index_e9,d0 |  [$3c7f: lda frame_index_e9] char data index to set
	asl.b	#1,d0                            	| [$3c81: asl a] times 2
	move.b	d0,d2                           	| [$3c82: tay]
* fetch pointers from tables
	GET_INDIRECT_ADDRESS	charset_data_pointer_17	| [$3c83: lda (charset_data_pointer_17), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,charset_source_pointer_first_plane_31,d0 |  [$3c85: sta charset_source_pointer_first_plane_31]
	GET_INDIRECT_ADDRESS	0x19              	| [$3c87: lda ($19), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,charset_source_pointer_second_plane_33,d0 |  [$3c89: sta charset_source_pointer_second_plane_33]
	addq.b	#1,d2                           	| [$3c8b: iny]
	GET_INDIRECT_ADDRESS	charset_data_pointer_17	| [$3c8c: lda (charset_data_pointer_17), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,0x32,d0 |  [$3c8e: sta $32]
	GET_INDIRECT_ADDRESS	0x19              	| [$3c90: lda ($19), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,0x34,d0 |  [$3c92: sta $34]
	OP_R_ON_ZP_ADDRESS	move,snake_head_direction_53,d0 |  [$3c94: lda snake_head_direction_53]
	cmp.b	#0x08,d0                         	| [$3c96: cmp #$08]
	beq	dir_left_special_char_copy_3cb6    	| [$3c98: beq dir_left_special_char_copy_3cb6]
* direct copy
* change 9 chars from character 0x61 or 0x31 depending on how $1b was loaded
straight_char_copy_3c9a:
* [copy_charset_data_loop=9,false]
	move.b	#0x47,d2                        	| [$3c9a: ldy #$47]
l_3c9c:
	GET_INDIRECT_ADDRESS	charset_source_pointer_first_plane_31	| [$3c9c: lda (charset_source_pointer_first_plane_31), y]
	move.b	(a0,d2.w),d0                    	| [...]
	GET_INDIRECT_ADDRESS	0x1b              	| [$3c9e: sta ($1b), y] change charset (going up/right/down)
	move.b	d0,(a0,d2.w)                    	| [...]
	subq.b	#1,d2                           	| [$3ca0: dey]
	bpl	l_3c9c                             	| [$3ca1: bpl $3c9c]
	move.b	#0x47,d2                        	| [$3ca3: ldy #$47]
	OP_R_ON_ZP_ADDRESS	move,0x1c,d0 |  [$3ca5: lda $1c]
	                           	| [$3ca7: clc]
	add.b	#0x08,d0                        	| [$3ca8: adc #$08]
	OP_W_ON_ZP_ADDRESS	move,0x1c,d0 |  [$3caa: sta $1c] second plane
l_3cac:
	GET_INDIRECT_ADDRESS	charset_source_pointer_second_plane_33	| [$3cac: lda (charset_source_pointer_second_plane_33), y]
	move.b	(a0,d2.w),d0                    	| [...]
	GET_INDIRECT_ADDRESS	0x1b              	| [$3cae: sta ($1b), y]
	move.b	d0,(a0,d2.w)                    	| [...]
	subq.b	#1,d2                           	| [$3cb0: dey]
	bpl	l_3cac                             	| [$3cb1: bpl $3cac]
	jra	charset_copy_done_3cdf             	| [$3cb3: jmp charset_copy_done_3cdf]

* left is like right but as bitplane data is vertical, the game reuses
* the data by copying it in the other direction
* (it cannot do that for vertical up/down as bits are mixed)
* left is the only special case as up, down and right data are good to copy as is
* in the 3 charset tables
dir_left_special_char_copy_3cb6:
* [copy_charset_data_loop=9,true] mirrored
	move.b	#0x47,d2                        	| [$3cb6: ldy #$47] change 9 chars from character 0x61
l_3cb8:
	OP_W_ON_ZP_ADDRESS	move,0x16,d2 |  [$3cb8: sty $16]
	move.b	d2,d0                           	| [$3cba: tya]
	eor.b	#0x07,d0                         	| [$3cbb: eor #$07] copy bytes in the other direction
	move.b	d0,d2                           	| [$3cbd: tay]
	GET_INDIRECT_ADDRESS	charset_source_pointer_first_plane_31	| [$3cbe: lda (charset_source_pointer_first_plane_31), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_R_ON_ZP_ADDRESS	move,0x16,d2 |  [$3cc0: ldy $16]
	GET_INDIRECT_ADDRESS	0x1b              	| [$3cc2: sta ($1b), y] charset when turning left
	move.b	d0,(a0,d2.w)                    	| [...]
	subq.b	#1,d2                           	| [$3cc4: dey]
	bpl	l_3cb8                             	| [$3cc5: bpl $3cb8]
* second bitplane
	move.b	#0x47,d2                        	| [$3cc7: ldy #$47]
	OP_R_ON_ZP_ADDRESS	move,0x1c,d0 |  [$3cc9: lda $1c]
	                           	| [$3ccb: clc]
	add.b	#0x08,d0                        	| [$3ccc: adc #$08]
	OP_W_ON_ZP_ADDRESS	move,0x1c,d0 |  [$3cce: sta $1c] second bitplane pointer
l_3cd0:
	OP_W_ON_ZP_ADDRESS	move,0x16,d2 |  [$3cd0: sty $16]
	move.b	d2,d0                           	| [$3cd2: tya]
	eor.b	#0x07,d0                         	| [$3cd3: eor #$07]
	move.b	d0,d2                           	| [$3cd5: tay]
	GET_INDIRECT_ADDRESS	charset_source_pointer_first_plane_31	| [$3cd6: lda (charset_source_pointer_first_plane_31), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_R_ON_ZP_ADDRESS	move,0x16,d2 |  [$3cd8: ldy $16]
	GET_INDIRECT_ADDRESS	0x1b              	| [$3cda: sta ($1b), y]
	move.b	d0,(a0,d2.w)                    	| [...]
	subq.b	#1,d2                           	| [$3cdc: dey]
	bpl	l_3cd0                             	| [$3cdd: bpl $3cd0]

* from now on, no more charset changes, but from time to time the game
* must move nibbler head & tail (typical snake game behaviour where only
* the start & end of the snake changes)
charset_copy_done_3cdf:
	OP_R_ON_ZP_ADDRESS	move,snake_head_direction_53,d0 |  [$3cdf: lda snake_head_direction_53]
	cmp.b	#0x01,d0                         	| [$3ce1: cmp #$01]
	beq	dir_down_3cf7                      	| [$3ce3: beq dir_down_3cf7]
	cmp.b	#0x02,d0                         	| [$3ce5: cmp #$02]
	beq	dir_up_3cfc                        	| [$3ce7: beq dir_up_3cfc]
	cmp.b	#0x04,d0                         	| [$3ce9: cmp #$04]
	beq	dir_right_3cf2                     	| [$3ceb: beq dir_right_3cf2]
	OP_W_ON_ZP_ADDRESS	addq,tail_oriented_up_43,#1 |  [$3ced: inc tail_oriented_up_43]
	jra	dir_left_3cfe                      	| [$3cef: jmp dir_left_3cfe]
dir_right_3cf2:
	OP_W_ON_ZP_ADDRESS	addq,tail_oriented_down_42,#1 |  [$3cf2: inc tail_oriented_down_42]
	jra	dir_left_3cfe                      	| [$3cf4: jmp dir_left_3cfe]
dir_down_3cf7:
	OP_W_ON_ZP_ADDRESS	addq,tail_oriented_left_40,#1 |  [$3cf7: inc tail_oriented_left_40]
	jra	dir_left_3cfe                      	| [$3cf9: jmp dir_left_3cfe]
dir_up_3cfc:
	OP_W_ON_ZP_ADDRESS	addq,tail_oriented_right_41,#1 |  [$3cfc: inc tail_oriented_right_41]
dir_left_3cfe:
* load pointer on table 3E9D:
*     3E9D  01 01 01 01 01 01 02 02 02 01 02 01 01 01 01 01   ................
*     3EAD  02 02 02 02 03 03 03 03 03 03 03 03 02 02 02 02   ................

	move.b	#0x9d,d0                        	| [$3cfe: lda #$9d]
	OP_W_ON_ZP_ADDRESS	move,head_x_value_17,d0 |  [$3d00: sta head_x_value_17]
	move.b	#0x3e,d0                        	| [$3d02: lda #$3e]
	PUSH_SR
	OP_W_ON_ZP_ADDRESS	move,0x18,d0 |  [$3d04: sta $18]
	POP_SR

	OP_R_ON_ZP_ADDRESS	move,0x3d,d0 |  [$3d06: lda $3d]
	CLR_XC_FLAGS                           	| [$3d08: clc]
	OP_R_ON_ZP_ADDRESS	add,head_x_value_17,d0 |  [$3d09: adc head_x_value_17]
	OP_W_ON_ZP_ADDRESS	move,head_x_value_17,d0 |  [$3d0b: sta head_x_value_17]
	OP_R_ON_ZP_ADDRESS	move,0x18,d0 |  [$3d0d: lda $18]
	move.b	#0x00,d4	| [$3d0f: adc #$00]
	addx.b	d4,d0                        	| [$3d0f: adc #$00]
	OP_W_ON_ZP_ADDRESS	move,0x18,d0 |  [$3d11: sta $18]
	clr.b	d2                               	| [$3d13: ldy #$00]
	GET_INDIRECT_ADDRESS	head_x_value_17   	| [$3d15: lda (head_x_value_17), y]
	move.b	(a0,d2.w),d0                    	| [...]
	CLR_XC_FLAGS                           	| [$3d17: clc]
	OP_R_ON_ZP_ADDRESS	add,snake_head_row_51,d0 |  [$3d18: adc snake_head_row_51]
	OP_W_ON_ZP_ADDRESS	move,0x19,d0 |  [$3d1a: sta $19]
	move.b	#0x08,d2                        	| [$3d1c: ldy #$08]
	GET_INDIRECT_ADDRESS	head_x_value_17   	| [$3d1e: lda (head_x_value_17), y]
	move.b	(a0,d2.w),d0                    	| [...]
	CLR_XC_FLAGS                           	| [$3d20: clc]
	OP_R_ON_ZP_ADDRESS	add,snake_head_col_52,d0 |  [$3d21: adc snake_head_col_52]
	OP_W_ON_ZP_ADDRESS	move,0x1a,d0 |  [$3d23: sta $1a]
	move.b	#0x10,d2                        	| [$3d25: ldy #$10]
	GET_INDIRECT_ADDRESS	head_x_value_17   	| [$3d27: lda (head_x_value_17), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,charset_source_pointer_first_plane_31,d0 |  [$3d29: sta charset_source_pointer_first_plane_31]
	move.b	#0x18,d2                        	| [$3d2b: ldy #$18]
	GET_INDIRECT_ADDRESS	head_x_value_17   	| [$3d2d: lda (head_x_value_17), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,0x32,d0 |  [$3d2f: sta $32]
* load with pointer on 3E2D pointer table:
* 3E2D
*	dc.w	$3E3D
*	dc.w	$3E49
*	dc.w	$3E55
*	dc.w	$3E61
*	dc.w	$3E6D
*	dc.w	$3E79
*	dc.w	$3E85
*	dc.w	$3E91

	move.b	#0x2d,d0                        	| [$3d31: lda #$2d]
	OP_W_ON_ZP_ADDRESS	move,0x1d,d0 |  [$3d33: sta $1d]
	move.b	#0x3e,d0                        	| [$3d35: lda #$3e]
	OP_W_ON_ZP_ADDRESS	move,0x1e,d0 |  [$3d37: sta $1e]
	OP_R_ON_ZP_ADDRESS	move,0x4a,d0 |  [$3d39: lda $4a]
	beq	l_3d45                             	| [$3d3b: beq $3d45]
* 3EBD, a different pointer table
*	dc.w	$3ECD
*	dc.w	$3ED9
*	dc.w	$3EE5
*	dc.w	$3EF1
*	dc.w	$3EFD
*	dc.w	$3F09
*	dc.w	$3F15
*	dc.w	$3F21
*
* both tables point on char indexes of the nibbler body
*
	move.b	#0xbd,d0                        	| [$3d3d: lda #$bd]
	OP_W_ON_ZP_ADDRESS	move,0x1d,d0 |  [$3d3f: sta $1d]
	move.b	#0x3e,d0                        	| [$3d41: lda #$3e]
	OP_W_ON_ZP_ADDRESS	move,0x1e,d0 |  [$3d43: sta $1e]
l_3d45:
	OP_R_ON_ZP_ADDRESS	move,0x3d,d0 |  [$3d45: lda $3d]
	asl.b	#1,d0                            	| [$3d47: asl a]
	move.b	d0,d2                           	| [$3d48: tay]
	GET_INDIRECT_ADDRESS	0x1d              	| [$3d49: lda ($1d), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,0x1b,d0 |  [$3d4b: sta $1b]
	addq.b	#1,d2                           	| [$3d4d: iny]
	GET_INDIRECT_ADDRESS	0x1d              	| [$3d4e: lda ($1d), y]
	move.b	(a0,d2.w),d0                    	| [...]
	OP_W_ON_ZP_ADDRESS	move,0x1c,d0 |  [$3d50: sta $1c]
	OP_R_ON_ZP_ADDRESS	move,charset_source_pointer_first_plane_31,d1 |  [$3d52: ldx charset_source_pointer_first_plane_31]
	OP_R_ON_ZP_ADDRESS	move,0x19,d0 |  [$3d54: lda $19]
	cmp.b	#0x1c,d0                         	| [$3d56: cmp #$1c]
	* bcc=>bcs (cmp above)
	bcs	l_3d5f                             	| [$3d58: bcc $3d5f]
	move.b	#0x93,d0                        	| [$3d5a: lda #$93]
	jra	l_3f87                             	| [$3d5c: jmp $3f87]
l_3d5f:
	move.b	#0x1b,d0                        	| [$3d5f: lda #$1b]
	SET_XC_FLAGS                           	| [$3d61: sec]
	SBC	0x19                               	| [$3d62: sbc $19]
	CLR_XC_FLAGS                           	| [$3d64: clc]
                                         | [$3d65: rol a]
                                         | [$3d66: rol a]
                                         | [$3d67: rol a]
	roxl.b	#4,d0                           	| [$3d68: rol a]
	OP_W_ON_ZP_ADDRESS	move,head_x_value_17,d0 |  [$3d69: sta head_x_value_17]
	clr.b	d0                               	| [$3d6b: lda #$00]
	move.b	#0x00,d4	| [$3d6d: adc #$00]
	addx.b	d4,d0                        	| [$3d6d: adc #$00]
	asl.b	#1,d0                            	| [$3d6f: asl a]
	GET_ADDRESS	head_x_value_17            	| [$3d70: rol head_x_value_17]
	move.b	(a0),d4	| [...]
	roxl.b	#1,d4                         	| [...]
	PUSH_SR
	move.b	d4,(a0)	| [...]
	POP_SR
	move.b	#0x04,d4	| [$3d72: adc #$04]
	addx.b	d4,d0                        	| [$3d72: adc #$04]
	OP_W_ON_ZP_ADDRESS	move,0x18,d0 |  [$3d74: sta $18]
	move.b	#0x1f,d0                        	| [$3d76: lda #$1f]
	SET_XC_FLAGS                           	| [$3d78: sec]
	SBC	0x1a                               	| [$3d79: sbc $1a]
	CLR_XC_FLAGS                           	| [$3d7b: clc]
	OP_R_ON_ZP_ADDRESS	add,head_x_value_17,d0 |  [$3d7c: adc head_x_value_17]
	OP_W_ON_ZP_ADDRESS	move,head_x_value_17,d0 |  [$3d7e: sta head_x_value_17]
	OP_R_ON_ZP_ADDRESS	move,0x18,d0 |  [$3d80: lda $18]
	cmp.b	#0x08,d0                         	| [$3d82: cmp #$08]
	* bcc=>bcs (cmp above)
	bcs	l_3d8b                             	| [$3d84: bcc $3d8b]
	move.b	#0x94,d0                        	| [$3d86: lda #$94]
	jra	l_3f87                             	| [$3d88: jmp $3f87]
l_3d8b:
	OP_R_ON_ZP_ADDRESS	move,head_x_value_17,d0 |  [$3d8b: lda head_x_value_17]
	OP_W_ON_ZP_ADDRESS	move,0x1d,d0 |  [$3d8d: sta $1d]
	OP_R_ON_ZP_ADDRESS	move,0x18,d0 |  [$3d8f: lda $18]
	                           	| [$3d91: clc]
