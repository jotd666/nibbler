* responsible for:
* - tail erasure (else snake gets longer)
* - tail wriggling animation
handle_tail_a600:
	OP_R_ON_ZP_ADDRESS	move,time_when_snake_gets_longer_bb,d0 |  [$a600: lda time_when_snake_gets_longer_bb]
	beq	l_a605                             	| [$a602: beq $a605]
