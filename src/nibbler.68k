* animate body (not head or tail) each frame
* it just changes 4 tiles, making the diamond bigger or smaller
animate_body_chars_5bf4:
	OP_R_ON_ZP_ADDRESS	move,frame_index_e9,d0 |  [$5bf4: lda frame_index_e9] 0,2,4,6
                                         | [$5bf6: asl a]
                                         | [$5bf7: asl a]
	asl.b	#3,d0                            	| [$5bf8: asl a] times 8
	OP_W_ON_ZP_ADDRESS	move,0x16,d0 |  [$5bf9: sta $16]
	asl.b	#1,d0                            	| [$5bfb: asl a] times 16
	OP_W_ON_ZP_ADDRESS	move,0x1f,d0 |  [$5bfc: sta $1f]
	OP_R_ON_ZP_ADDRESS	move,tail_oriented_left_40,d0 |  [$5bfe: lda tail_oriented_left_40]
	beq	l_5c20                             	| [$5c00: beq l_5c20]
* load the proper charset data based from $6040, $6050, ...
* only the second plane is changed (faster, and we don't need to change the
* shape, only the diamond size in white)
*
* note that copies are done on 7 columns last column is not
* changed, a small optimization rendered possible because
* initial snake data (base charset) already has the red body
* shape right, we only have to draw the diamonds in it
*
* remember: each 8-bit byte data corresponds to a column (vertical)
*
* 3D & 3E: 1 row of black, 7 of foreground (red)
*
* BBBBBBB(B) (the last bit on each row is never changed)
* WWWWWWW(W)
* WWWWWWW(W)
* WWWWWWW(W)
* WWWWWWW(W)
* WWWWWWW(W)
* WWWWWWW(W)
* WWWWWWW(W)
*
* 3F & 40: 7 columns of foreground, 1 column of black
*
* WWWWWWW(B) (the last bit on each row is never changed)
* WWWWWWW(B)
* WWWWWWW(B)
* WWWWWWW(B)
* WWWWWWW(B)
* WWWWWWW(B)
* WWWWWWW(B)
* WWWWWWW(B)

	move.b	#0x40,d0                        	| [$5c02: lda #$40]
	CLR_XC_FLAGS                           	| [$5c04: clc]
	OP_R_ON_ZP_ADDRESS	add,0x16,d0 |  [$5c05: adc $16]
	OP_W_ON_ZP_ADDRESS	move,head_x_value_17,d0 |  [$5c07: sta head_x_value_17]
	move.b	#0x60,d0                        	| [$5c09: lda #$60]
	move.b	#0x00,d4	| [$5c0b: adc #$00]
	addx.b	d4,d0                        	| [$5c0b: adc #$00]
	OP_W_ON_ZP_ADDRESS	move,0x18,d0 |  [$5c0d: sta $18]
* second plane of char 0x3F data (vertical snake body)
	move.b	#0xf8,d0                        	| [$5c0f: lda #$f8]
	OP_W_ON_ZP_ADDRESS	move,0x19,d0 |  [$5c11: sta $19]
	move.b	#0x19,d0                        	| [$5c13: lda #$19]
	OP_W_ON_ZP_ADDRESS	move,0x1a,d0 |  [$5c15: sta $1a]
	CHANGE_CHARS	1,0 | * [copy_charset_data_loop=1,false]
	move.b	#0x07,d2                        	| [$5c17: ldy #$07] 7 columns not 8!
l_5c19:
	GET_INDIRECT_ADDRESS	head_x_value_17   	| [$5c19: lda (head_x_value_17), y]
	move.b	(a0,d2.w),d0                    	| [...]
	GET_INDIRECT_ADDRESS	0x19              	| [$5c1b: sta ($19), y]
	move.b	d0,(a0,d2.w)                    	| [...]
	subq.b	#1,d2                           	| [$5c1d: dey]
	bpl	l_5c19                             	| [$5c1e: bpl $5c19]
l_5c20:
	OP_R_ON_ZP_ADDRESS	move,tail_oriented_right_41,d0 |  [$5c20: lda tail_oriented_right_41]
	beq	l_5c42                             	| [$5c22: beq $5c42] 0: oriented right
* load the proper charset data based from $6080, $6090, ...
	move.b	#0x80,d0                        	| [$5c24: lda #$80]
