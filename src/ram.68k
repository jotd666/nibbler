
	.global		ram_start_0000
	.global		ram_buffer	
	.global		stack_top
	.global		vb_ticks_count
	.global		break_at_startup_flag
	.global		charbank_value
	.global		start_level_flag
	.global		infinite_lives_flag
	.global		invincible_flag
	.global		infinite_time_flag
	.global		current_background_value
	.ifndef		RELEASE
	.endif

* ram also includes video & sprite ram, with ROM and 1 banked ROM
* (the other is either copied in the bank address or addressed directly)
ram_buffer:
	.ifdef	RELEASE
	.skip	0x10000
	.else
	.skip	0x20000
ram_start_0000:
	.long	0

	
	.align	2
	.endif



vb_ticks_count:
	.skip	1

break_at_startup_flag:
	.skip	1
start_level_flag:
	.skip	1
infinite_time_flag:
	.skip	1
infinite_lives_flag:
	.skip	1
invincible_flag:
	.skip	1
	

current_background_value:
	.skip	1

charbank_value:
	.skip	1
	



